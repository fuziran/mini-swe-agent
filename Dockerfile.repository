FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/mini-swe-agent
COPY pyproject.toml ./
RUN python -c 'import tomllib; from pathlib import Path; print("\n".join(tomllib.loads(Path("pyproject.toml").read_text())["project"]["dependencies"]))' > requirements.txt
RUN --mount=type=cache,id=repository-pip,target=/root/.cache/pip \
    pip install --timeout 120 --retries 6 -r requirements.txt pytest setuptools wheel
COPY README.md LICENSE.md ./
COPY src ./src
RUN pip install --no-deps --no-build-isolation .

WORKDIR /workspace
